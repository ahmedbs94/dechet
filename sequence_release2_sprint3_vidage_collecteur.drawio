]" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="245" y="320" width="300" height="25" as="geometry"/></mxCell><mxCell id="c6" value="5. Activer le mode vidage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="360"/></Array></mxGeometry></mxCell><mxCell id="c7" value="6. Ouvrir le mécanisme" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="400"/></Array></mxGeometry></mxCell><mxCell id="c8" value="7. Retirer les déchets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="col" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="440"/></Array></mxGeometry></mxCell><mxCell id="c9" value="8. Mesurer le poids avant vidage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="480"/></Array></mxGeometry></mxCell><mxCell id="refB" value="ref Enregistrer l’opération de collecte" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="500" width="350" height="60" as="geometry"/></mxCell><mxCell id="c10" value="9. Enregistrer CollectorLog" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="api"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="540"/></Array></mxGeometry></mxCell><mxCell id="c11" value="10. Réinitialiser la balance (tare)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="580"/></Array></mxGeometry></mxCell><mxCell id="c12" value="11. Mettre à jour le bac : poids = 0, état = disponible" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="fb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="620"/></Array></mxGeometry></mxCell><mxCell id="c13" value="[QR invalide ou rôle différent de collecteur]" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="245" y="665" width="360" height="25" as="geometry"/></mxCell><mxCell id="c14" value="12. Refuser le mode vidage et afficher un message" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="705"/></Array></mxGeometry></mxCell><mxCell id="loop" value="loop [pour chaque poubelle de la tournée]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="750" width="1050" height="120" as="geometry"/></mxCell><mxCell id="c15" value="13. Passer à la poubelle suivante" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="col" target="esp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="795"/></Array></mxGeometry></mxCell><mxCell id="c16" value="14. Afficher « Bac vide »" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPo