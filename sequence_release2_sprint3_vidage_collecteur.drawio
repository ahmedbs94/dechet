<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-09-21T21:00:00.000Z"><diagram name="Diagramme de séquence – Vidage collecteur"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Diagramme de séquence – Vidage collecteur" style="text;html=1;strokeColor=none;fillColor=none;fontSize=19;fontStyle=1;fontColor=#0B2E78;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1450" height="35" as="geometry"/></mxCell><mxCell id="col" value="Collecteur" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#4A5568;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="150" height="820" as="geometry"/></mxCell><mxCell id="esp" value="ESP32-CAM / SmartBin" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#4A5568;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="150" height="820" as="geometry"/></mxCell><mxCell id="fb" value="Firebase Realtime Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#4A5568;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="150" height="820" as="geometry"/></mxCell><mxCell id="api" value="API EcoRewind" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#4A5568;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="80" width="150" height="820" as="geometry"/></mxCell><mxCell id="hw" value="HX711 / Servomoteur / LCD" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#4A5568;fontSize=11;" vertex="1" parent="1"><mxGeometry x="990" y="80" width="150" height="820" as="geometry"/></mxCell><mxCell id="sd" value="sd Vidage d’une poubelle intelligente pa