nt="1" source="cam" target="hw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6" value="6. Ouvrir le mécanisme de vidage" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="hw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="7" value="7. Retirer les déchets" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="col" target="hw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="8" value="8. Lire le poids avant vidage" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="hw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ref2" value="ref Enregistrer l’opération de collecte" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="475" width="350" height="65" as="geometry"/></mxCell><mxCell id="9" value="9. Enregistrer CollectorLog" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="10. Effectuer la tare / remettre le poids à zéro" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="hw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="11" value="11. Synchroniser l’état « vide »" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="fb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="12. Confirmer la mise à jour" style="dashed=1;endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="fb" target="cam"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="13. Afficher « Bac vide »" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="hw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" value="[QR invalide ou rôle différent de collector]" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="250" y="680" width="350" height="25" as="geometry"/></mxCell><mxCell id="14" value="14. Refuser le mode vidage" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="hw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="loop" value="loop [pour chaque poubelle de la tournée]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="755" width="1100" height="120" as="geometry"/></mxCell><mxCell id="l" value="15. Passer à la poubelle suivante" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="250" y="790" width="350" height="25" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>