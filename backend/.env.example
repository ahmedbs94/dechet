# .env.example — Variables d'environnement EcoRewind
# ====================================================
# Copier ce fichier en .env et remplir les valeurs

# ── Sécurité ───────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# ── Authentification OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Base de données ───────────────────────────────────────────────────────────
#
# OPTION 1 — PostgreSQL local via Docker (RECOMMANDÉ)
# 1. Lancer : docker compose up -d
# 2. Appliquer les migrations : migrate.bat up (Windows) ou ./migrate.sh up
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecorewind
#
# OPTION 2 — PostgreSQL distant (production Railway/Render)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
#
# OPTION 3 — SQLite local (fallback minimal, tests rapides uniquement)
# Commenter DATABASE_URL ci-dessus pour activer SQLite automatiquement.
# ATTENTION : comportements différents de PostgreSQL (FK, JSON, enums, concurrence)
#
# ── Risques SQLite vs PostgreSQL ──────────────────────────────────────────────
# | Sujet                  | SQLite      | PostgreSQL  |
# | FK constraints         | désactivées | strictes    |
# | JSON queries           | limité      | puissant    |
# | Transactions concurr.  | limitées    | solides     |
# | Enums                  | simulés     | natifs      |
# | Migrations ALTER TABLE | batch mode  | direct      |

# ── Email (FastAPI-Mail) ───────────────────────────────────────────────────────
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com

# ── SMTP (invitations Google Meet) ────────────────────────────────────────────
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# ── CORS ──────────────────────────────────────────────────────────────────────
# En dev : CORS_ORIGINS=* (autorise tout)
# En prod : CORS_ORIGINS=https://monapp.com,https://app.mondomaine.com
CORS_ORIGINS=*

# ── Environnement ─────────────────────────────────────────────────────────────
APP_ENV=development  # development | production

# ── Gemini API (Quiz automatique) ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com/

# ── AI Worker (processus séparé — backend/ai_worker/worker.py) ─────────────
AI_WORKER_POLL_INTERVAL=5    # Secondes entre chaque vérification des posts pending_ai
AI_WORKER_BATCH_SIZE=10      # Nombre de posts traités par cycle
AI_WORKER_LOG_LEVEL=INFO     # DEBUG | INFO | WARNING | ERROR
