# =============================================================================
# EcoRewind Backend — Variables d'environnement
# =============================================================================
# Copiez ce fichier vers .env et remplissez les valeurs.
# Les valeurs marquées [OBLIGATOIRE] doivent être définies.
# Les valeurs marquées [DEV UNIQUEMENT] ne doivent pas être utilisées en prod.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────

# Environnement : development | staging | production
# En staging/production, DATABASE_URL est obligatoire.
APP_ENV=development

# Clé secrète JWT — générez avec : openssl rand -hex 32
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32

# ── Base de données [OBLIGATOIRE en staging/production] ───────────────────────
#
# PostgreSQL est la base OFFICIELLE d'EcoRewind.
# SQLite est toléré uniquement en APP_ENV=development pour du prototypage rapide.
#
# Format : postgresql://user:password@host:port/dbname
#
# Exemples :
#   Local dev      : postgresql://postgres:password@localhost:5432/ecorewind
#   Docker         : postgresql://ecorewind:secret@db:5432/ecorewind
#   Railway        : postgresql://... (copier depuis le dashboard Railway)
#   Render         : postgresql://... (copier depuis le dashboard Render)
#
# Pourquoi PostgreSQL ?
#   - Concurrence réelle (vs verrous fichier SQLite)
#   - Intégrité référentielle avec ON DELETE CASCADE/SET NULL
#   - Types natifs : JSONB, ARRAY, UUID, INET
#   - ALTER TABLE sans limitation (SQLite nécessite une reconstruction)
#   - Cohérence dev/staging/production
#
DATABASE_URL=postgresql://postgres:CHANGE_ME_password@localhost:5432/ecorewind

# ── Authentification Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME_google_client_id

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
MAIL_FROM=no-reply@ecorewind.app
MAIL_PASSWORD=CHANGE_ME_smtp_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_PASSWORD=CHANGE_ME_smtp_app_password

# ── IA / APIs externes ────────────────────────────────────────────────────────
GEMINI_API_KEY=CHANGE_ME_gemini_api_key

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_DATABASE_URL=https://YOUR_PROJECT-default-rtdb.europe-west1.firebasedatabase.app

# ── CORS ──────────────────────────────────────────────────────────────────────
# En production, remplacez * par le domaine exact de votre frontend
CORS_ORIGINS=*
