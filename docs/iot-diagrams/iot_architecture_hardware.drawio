<mxfile host="app.diagrams.net"><diagram name="Architecture matérielle IoT"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="ECOREWIND — ARCHITECTURE MATÉRIELLE DU PROTOTYPE IOT" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1" vertex="1" parent="1"><mxGeometry x="250" y="20" width="1100" height="40" as="geometry"/></mxCell><mxCell id="esp" value="ESP32-CAM AI Thinker&lt;br&gt;Unité centrale&lt;br&gt;Caméra OV2640 intégrée&lt;br&gt;QR, Wi-Fi, Deep Sleep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;fontSize=15;fontStyle=1" vertex="1" parent="1"><mxGeometry x="640" y="260" width="280" height="150" as="geometry"/></mxCell><mxCell id="pir" value="PIR HC-SR505&lt;br&gt;Présence / réveil&lt;br&gt;OUT → GPIO 14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2e7d32;fontSize=14" vertex="1" parent="1"><mxGeometry x="80" y="130" width="230" height="90" as="geometry"/></mxCell><mxCell id="cam" value="Caméra OV2640&lt;br&gt;intégrée à l’ESP32-CAM&lt;br&gt;Lecture QR code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#674ea7;fontSize=14" vertex="1" parent="1"><mxGeometry x="80" y="250" width="230" height="90" as="geometry"/></mxCell><mxCell id="load" value="Bac + cellule de charge&lt;br&gt;Mesure force / poids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2e7d32;fontSize=14" vertex="1" parent="1"><mxGeometry x="80" y="370" width="230" height="90" as="geometry"/></mxCell><mxCell id="hx" value="Module HX711&lt;br&gt;DOUT → GPIO 1&lt;br&gt;SCK → GPIO 3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2e7d32;fontSize=14" vertex="1" parent="1"><mxGeometry x="360" y="370" width="210" height="90" as="geometry"/></mxCell><mxCell id="lcd" value="LCD I²C 16×2&lt;br&gt;SDA → GPIO 15&lt;br&gt;SCL → GPIO 13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="240" height="90" as="geometry"/></mxCell><mxCell id="s1" value="Servo utilisateur&lt;br&gt;Couvercle dépôt&lt;br&gt;PWM → GPIO 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14" vertex="1" parent="1"><mxGeometry x="1060" y="270" width="240" height="90" as="geometry"/></mxCell><mxCell id="s2" value="Servo collecteur&lt;br&gt;Couvercle vidage&lt;br&gt;PWM → GPIO 4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14" vertex="1" parent="1"><mxGeometry x="1060" y="400" width="240" height="90" as="geometry"/></mxCell><mxCell id="power" value="Alimentation stabilisée 5 V / 3 A min&lt;br&gt;Rail 5 V pour ESP32, LCD et servos&lt;br&gt;Masse commune GND&lt;br&gt;Condensateur 470–1000 µF près des servos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#bf9000;fontSize=14" vertex="1" parent="1"><mxGeometry x="170" y="620" width="430" height="130" as="geometry"/></mxCell><mxCell id="fb" value="Firebase Realtime Database&lt;br&gt;/utilisateurs/{qrID}/role&lt;br&gt;/score&lt;br&gt;/poubelles/BIN-GENERAL-001/poids, état" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#674ea7;fontSize=14" vertex="1" parent="1"><mxGeometry x="980" y="620" width="390" height="130" as="geometry"/></mxCell><mxCell id="wifi" value="Wi-Fi / Internet" style="ellipse;whiteSpace=wrap;html=1;fillColor=#cfe2f3;strokeColor=#3d85c6;fontSize=14" vertex="1" parent="1"><mxGeometry x="700" y="640" width="170" height="80" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=classic;html=1;strokeColor=#2e7d32" edge="1" parent="1" source="pir" target="esp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="endArrow=classic;html=1;strokeColor=#674ea7" edge="1" parent="1" source="cam" target="esp"><mxGeometry relativ