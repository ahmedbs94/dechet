<mxfile host="app.diagrams.net"><diagram name="États énergie"><mxGraphModel dx="1200" dy="850" grid="1" page="1" pageWidth="1300" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="Diagramme d’états — gestion énergétique et présence" style="text;html=1;fontSize=24;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="300" y="20" width="800" height="40" as="geometry"/></mxCell><mxCell id="sleep" value="Deep Sleep&lt;br&gt;réveil EXT0 GPIO 14 = HIGH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14" vertex="1" parent="1"><mxGeometry x="90" y="320" width="220" height="90" as="geometry"/></mxCell><mxCell id="boot" value="Démarrage actif&lt;br&gt;cause : PIR ou reset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;fontSize=14" vertex="1" parent="1"><mxGeometry x="390" y="320" width="220" height="90" as="geometry"/></mxCell><mxCell id="init" value="Initialisation&lt;br&gt;caméra, LCD, Wi-Fi,&lt;br&gt;Firebase, HX711, QR task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2e7d32;fontSize=14" vertex="1" parent="1"><mxGeometry x="700" y="300" width="230" height="120" as="geometry"/></mxCell><mxCell id="wait" value="Attente active&lt;br&gt;QR et présence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1f4e79;fontSize=14" vertex="1" parent="1"><mxGeometry x="1010" y="320" width="200" height="90" as="geometry"/></mxCell><mxCell id="process" value="Traitement interaction&lt;br&gt;busy = true&lt;br&gt;rôle Firebase, servo, poids" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#674ea7;fontSize=14" vertex="1" parent="1"><mxGeometry x="780" y="560" width="260" height="110" as="geometry"/></mxCell><mxCell id="actions" value="Action d’entrée Deep Sleep&lt;br&gt;• détacher servos&lt;br&gt;• HX711 power_down si prêt&lt;br&gt;• LCD backlight off&lt;br&gt;• Wi-Fi off&lt;br&gt;• wakeup EXT0 GPIO14" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13" vertex="1" parent="1"><mxGeometry x="70" y="560" width="300" height="150" as="geometry"/></mxCell><mxCell id="e1" value="PIR détecte présence" style="endArrow=classic;html=1" edge="1" parent="1" source="sleep" target="boot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="PIR HIGH" style="endArrow=classic;html=1" edge="1" parent="1" source="boot" target="init"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="initialisation OK" style="endArrow=classic;html=1" edge="1" parent="1" source="init" target="wait"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="QR reçu" style="endArrow=classic;html=1" edge="1" parent="1" source="wait" target="process"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="fin traitement" style="endArrow=classic;html=1" edge="1" parent="1" source="process" target="wait"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="PIR LOW et absence ≥ 10 s" style="endArrow=classic;html=1" edge="1" parent="1" source="wait" target="actions"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="esp_deep_sleep_start()" style="endArrow=classic;html=1" edge="1" parent="1" source="actions" target="sleep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="PIR LOW au boot" style="endArrow=classic;html=1" edge="1" parent="1" source="boot" target="sleep"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="230"/><mxPoint x="200" y="230"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>