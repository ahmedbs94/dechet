 / Scannez QR code »" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;align=left" vertex="1" parent="1"><mxGeometry x="1000" y="1360" width="1080" height="55" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>