<mxfile host="app.diagrams.net" agent="GitHub Copilot" version="24.7.17"><diagram id="iot-class-ecorewind" name="Classes IoT EcoRewind"><mxGraphModel dx="2600" dy="1700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="2200" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Diagramme de classes — Partie IoT EcoRewind" style="text;html=1;strokeColor=none;fillColor=none;fontSize=30;fontStyle=1;fontColor=#1F4E79;align=center" vertex="1" parent="1"><mxGeometry x="530" y="30" width="1120" height="50" as="geometry"/></mxCell><mxCell id="note" value="Modélisation issue du sketch ESP32-CAM : QR code, PIR, HX711, LCD I²C, deux servomoteurs, Wi-Fi, Firebase RTDB et Deep Sleep. Les secrets Wi-Fi/Firebase ne sont pas représentés." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#6C757D;fontSize=15;align=left;spacing=12" vertex="1" parent="1"><mxGeometry x="250" y="95" width="1700" height="60" as="geometry"/></mxCell><mxCell id="ctrl" value="&lt;b&gt;EcoRewindController&lt;/b&gt;&lt;hr&gt;- busy : bool&lt;br&gt;- ignoreQR : bool&lt;br&gt;- lastQR : String&lt;br&gt;- lastQRTime : unsigned long&lt;br&gt;- lastPresenceTime : unsigned long&lt;br&gt;- qrQueue : QueueHandle_t&lt;br&gt;- BIN_ID : String = BIN-GENERAL-001&lt;br&gt;- POINTS_PER_KG : float = 500&lt;br&gt;- BIN_FULL_WEIGHT_KG : float = 2.5&lt;hr&gt;+ setup() : void&lt;br&gt;+ loop() : void&lt;br&gt;+ checkUser(qrID : String) : void&lt;br&gt;+ readBinWeightKg() : float&lt;br&gt;+ updateUserScore(qrID : String, points : int) : void&lt;br&gt;+ updateBinWeight(weightKg : float) : void" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=28;html=1;whiteSpace=wrap;rounded=0;fillColor=#DAE8FC;strokeColor=#1F4E79;fontSize=14;align=left;spacing=8" vertex="1" parent="1"><mxGeometry x="770" y="220" width="470" height="330" as="geometry"/></mxCell><mxCell id="qr" value="&lt;b&gt;QRReaderTask&lt;/b&gt;&lt;hr&gt;- reader :