<mxfile host="app.diagrams.net" agent="GitHub Copilot"><diagram id="signup" name="Créer un compte"><mxGraphModel grid="1" page="1" pageWidth="1800" pageHeight="1050"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f" value="sd Créer un compte" style="shape=umlFrame;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="1700" height="900" as="geometry"/></mxCell><mxCell id="a" value="Visiteur" style="shape=umlActor;html=1;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="80" y="80" width="70" height="80" as="geometry"/></mxCell><mxCell id="ui" value="&amp;lt;&amp;lt;boundary&amp;gt;&amp;gt;&lt;br&gt;Formulaire Flutter" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="80" width="160" height="770" as="geometry"/></mxCell><mxCell id="api" value="&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;br&gt;Routeur Auth" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="650" y="80" width="150" height="770" as="geometry"/></mxCell><mxCell id="svc" value="&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;br&gt;Service bcrypt / Firebase" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="980" y="80" width="190" height="770" as="geometry"/></mxCell><mxCell id="db" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;br&gt;PostgreSQL / User" style="shape=umlLifeline;perimeter=lifelinePerimeter;html=1;" vertex="1" parent="1"><mxGeometry x="1370" y="80" width="170" height="770" as="geometry"/></mxCell><mxCell id="m1" value="1. saisir les données d'inscription" style="endArrow=block;html=1;" edge="1" parent="1" source="a" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m2" value="2. POST /register (UserCreate)" style="endArrow=block;html=1;" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m3" value="3. rechercher User par email" style="endArrow=block;html=1;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="alt" value="alt" style="shape=umlFrame;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="260" y="360" width="1280" height="430" as="geometry"/></mxCell><mxCell id="g1" value="[email déjà enregistré]" style="text;html=1;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="385" width="250" height="25" as="geometry"/></mxCell><mxCell id="r1" value="4a. HTTP 400 — Email already registered" style="dashed=1;endArrow=open;html=1;" edge="1" parent="1" source="api" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sep" style="endArrow=none;dashed=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="260" y="480" as="sourcePoint"/><mxPoint x="1540" y="480" as="targetPoint"/></mxGeometry></mxCell><mxCell id="g2" value="[email disponible et données valides]" style="text;html=1;align=left;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="490" width="330" height="25" as="geometry"/></mxCell><mxCell id="h" value="4b. get_password_hash(password)" style="endArrow=block;html=1;" edge="1" parent="1" source="api" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c" value="5b. créer User (is_verified=false, QR=UUID4 par défaut)" style="endArrow=block;html=1;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ret" value="6b. User persisté" style="dashed=1;endArrow=open;html=1;" edge="1" parent="1" source="db" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="sync" value="7b. sync_user_to_firebase() [non bloquant]" style="endArrow=block;html=1;" edge="1" parent="1" source="api" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ok" value="8b. HTTP 200 + compte créé" style="dashed=1;endArrow=open;html=1;" edge="1" parent="1" source="api" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="show" value="9. afficher la confirmation / étape OTP" style="dashed=1;endArrow=open;html=1;" edge="1" parent="1" source="ui" target="a"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>