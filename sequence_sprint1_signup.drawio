<mxfile host="app.diagrams.net" agent="GitHub Copilot"><diagram id="signup-correct" name="Créer un compte"><mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" page="1" pageWidth="2000" pageHeight="1250"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="sd Créer et vérifier un compte" style="shape=umlFrame;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1900" height="1120" as="geometry"/></mxCell><mxCell id="actor" value="Visiteur" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="65" y="70" width="70" height="80" as="geometry"/></mxCell><mxCell id="ui" value="&amp;lt;&amp;lt;boundary&amp;gt;&amp;gt;&lt;br&gt;Écran d'inscription Flutter" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="70" width="190" height="980" as="geometry"/></mxCell><mxCell id="api" value="&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;br&gt;Routeur Auth FastAPI" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="690" y="70" width="180" height="980" as="geometry"/></mxCell><mxCell id="service" value="&amp;lt;&amp;lt;control&amp;gt;&amp;gt;&lt;br&gt;Service bcrypt / OTP / JWT" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="70" width="190" height="980" as="geometry"/></mxCell><mxCell id="db" value="&amp;lt;&amp;lt;entity&amp;gt;&amp;gt;&lt;br&gt;PostgreSQL&lt;br&gt;User / OTPCode" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1510" y="70" width="170" height="980" as="geometry"/></mxCell><mxCell id="m1" value="1. remplir nom, email (ou téléphone), mot de passe,&lt;br&gt;confirmation et accepter les conditions" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="actor" target="ui"><mxGeometry relative="1" as="geometry"><mxPoint y="185" as="sourcePoint"/><mxPoint y="185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m2" value="2. valider les champs localement" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="ui" target="ui"><mxGeometry relative="1" as="geometry"><mxPoint y="250" as="sourcePoint"/><mxPoint y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="altFields" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="290" width="1450" height="260" as="geometry"/></mxCell><mxCell id="guardInvalid" value="[champ obligatoire absent, mot de passe &amp;lt; 6, confirmation différente ou conditions refusées]" style="text;html=1;align=left;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="312" width="650" height="25" as="geometry"/></mxCell><mxCell id="invalid" value="3a. afficher les erreurs de validation" style="dashed=1;endArrow=open;html=1;fontSize=11;" edge="1" parent="1" source="ui" target="actor"><mxGeometry relative="1" as="geometry"><mxPoint y="365" as="sourcePoint"/><mxPoint y="365" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sepFields" style="dashed=1;endArrow=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="405" as="sourcePoint"/><mxPoint x="1700" y="405" as="targetPoint"/></mxGeometry></mxCell><mxCell id="guardValid" value="[formulaire valide]" style="text;html=1;align=left;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="410" width="210" height="25" as="geometry"/></mxCell><mxCell id="register" value="3b. POST /register (email, full_name, role=user, password)" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry"><mxPoint y="465" as="sourcePoint"/><mxPoint y="465" as="targetPoint"/></mxGeometry></mxCell><mxCell id="find" value="4. rechercher User par email" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"><mxPoint y="515" as="sourcePoint"/><mxPoint y="515" as="targetPoint"/></mxGeometry></mxCell><mxCell id="altEmail" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="570" width="1450" height="270" as="geometry"/></mxCell><mxCell id="guardExists" value="[email déjà utilisé]" style="text;html=1;align=left;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="592" width="220" height="25" as="geometry"/></mxCell><mxCell id="exists" value="5a. HTTP 400 — Email already registered" style="dashed=1;endArrow=open;html=1;fontSize=11;" edge="1" parent="1" source="api" target="ui"><mxGeometry relative="1" as="geometry"><mxPoint y="645" as="sourcePoint"/><mxPoint y="645" as="targetPoint"/></mxGeometry></mxCell><mxCell id="existsShow" value="6a. signaler que l'adresse est déjà associée à un compte" style="dashed=1;endArrow=open;html=1;fontSize=11;" edge="1" parent="1" source="ui" target="actor"><mxGeometry relative="1" as="geometry"><mxPoint y="690" as="sourcePoint"/><mxPoint y="690" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sepEmail" style="dashed=1;endArrow=none;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="720" as="sourcePoint"/><mxPoint x="1700" y="720" as="targetPoint"/></mxGeometry></mxCell><mxCell id="guardFree" value="[email disponible]" style="text;html=1;align=left;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="725" width="210" height="25" as="geometry"/></mxCell><mxCell id="hash" value="5b. get_password_hash(password)" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="api" target="service"><mxGeometry relative="1" as="geometry"><mxPoint y="770" as="sourcePoint"/><mxPoint y="770" as="targetPoint"/></mxGeometry></mxCell><mxCell id="insert" value="6b. INSERT User(is_verified=false, qr_code=UUID4)" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="api" target="db"><mxGeometry relative="1" as="geometry"><mxPoint y="810" as="sourcePoint"/><mxPoint y="810" as="targetPoint"/></mxGeometry></mxCell><mxCell id="send" value="7. POST /otp/send (identifier=email, method=email)" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry"><mxPoint y="865" as="sourcePoint"/><mxPoint y="865" as="targetPoint"/></mxGeometry></mxCell><mxCell id="otp" value="8. générer OTP 6 chiffres, expiration 5 min&lt;br&gt;et envoyer le courriel" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="api" target="service"><mxGeometry relative="1" as="geometry"><mxPoint y="910" as="sourcePoint"/><mxPoint y="910" as="targetPoint"/></mxGeometry></mxCell><mxCell id="code" value="9. saisir le code reçu" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="actor" target="ui"><mxGeometry relative="1" as="geometry"><mxPoint y="955" as="sourcePoint"/><mxPoint y="955" as="targetPoint"/></mxGeometry></mxCell><mxCell id="verify" value="10. POST /otp/verify (identifier, code)" style="endArrow=block;html=1;fontSize=11;" edge="1" parent="1" source="ui" target="api"><mxGeometry relative="1" as="geometry"><mxPoint y="1000" as="sourcePoint"/><mxPoint y="1000" as="targetPoint"/></mxGeometry></mxCell><mxCell id="altOtp" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="250" y="1035" width="1450" height="90" as="geometry"/></mxCell><mxCell id="otpBad" value="[code invalide ou expiré] afficher l'erreur et permettre un nouvel envoi" style="dashed=1;endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="api" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="otpGood" value="[code valide] marquer OTP utilisé, User.is_verified=true et retourner access_token" style="dashed=1;endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="api" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>