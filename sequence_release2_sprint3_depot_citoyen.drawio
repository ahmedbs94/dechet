<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-09-21T21:00:00.000Z"><diagram name="Diagramme de séquence – Dépôt citoyen"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Diagramme de séquence – Dépôt citoyen" style="text;html=1;strokeColor=none;fillColor=none;fontSize=19;fontStyle=1;fontColor=#0B2E78;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1450" height="35" as="geometry"/></mxCell><mxCell id="cit" value="Citoyen" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#4A5568;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="150" height="820" as="geometry"/></mxCell><mxCell id="esp" value="ESP32-CAM / SmartBin" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#4A5568;fontSize=11;" vertex="1" parent="1"><mxGeometry x="260" y="80" width="150" height="820" as="geometry"/></mxCell><mxCell id="fb" value="Firebase Realtime Database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#4A5568;fontSize=11;" vertex="1" parent="1"><mxGeometry x="500" y="80" width="150" height="820" as="geometry"/></mxCell><mxCell id="hw" value="HX711 / Servomoteur / LCD" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#4A5568;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="80" width="150" height="820" as="geometry"/></mxCell><mxCell id="api" value="API EcoRewind" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;fillColor=#F8FBFF;strokeColor=#4A5568;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1040" y="80" width="150" height="820" as="geometry"/></mxCell><mxCell id="sd" value="sd Dépôt d’un déchet par un citoyen" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="65" width="1320" height="900" as="geometry"/></mxCell><mxCell id="d1" value="1. Présenter le QR code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="cit" target="esp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="120"/></Array></mxGeometry></mxCell><mxCell id="d2" value="2. Scanner et décoder le QR code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="esp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="160"/></Array></mxGeometry></mxCell><mxCell id="d3" value="3. Vérifier l’utilisateur et son rôle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="fb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="200"/></Array></mxGeometry></mxCell><mxCell id="d4" value="4. Retourner les informations du QR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;" edge="1" parent="1" source="fb" target="esp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="240"/></Array></mxGeometry></mxCell><mxCell id="alt1" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="270" width="1100" height="360" as="geometry"/></mxCell><mxCell id="d5" value="[QR valide et rôle = citoyen]" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="245" y="295" width="300" height="25" as="geometry"/></mxCell><mxCell id="d6" value="5. Lire le poids avant dépôt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="335"/></Array></mxGeometry></mxCell><mxCell id="d7" value="6. Retourner le poids initial" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;" edge="1" parent="1" source="hw" target="esp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="375"/></Array></mxGeometry></mxCell><mxCell id="d8" value="7. Ouvrir le couvercle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="415"/></Array></mxGeometry></mxCell><mxCell id="d9" value="8. Déposer le déchet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="cit" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="455"/></Array></mxGeometry></mxCell><mxCell id="d10" value="9. Lire le poids après dépôt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="495"/></Array></mxGeometry></mxCell><mxCell id="d11" value="10. Calculer le poids ajouté" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="esp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="535"/></Array></mxGeometry></mxCell><mxCell id="ref1" value="ref Vérifier / attribuer les points" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="555" width="330" height="60" as="geometry"/></mxCell><mxCell id="d12" value="[QR invalide ou rôle non autorisé]" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="245" y="650" width="350" height="25" as="geometry"/></mxCell><mxCell id="d13" value="11. Afficher « QR non autorisé »" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="690"/></Array></mxGeometry></mxCell><mxCell id="loop1" value="loop [nouveau scan demandé]" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="735" width="1100" height="120" as="geometry"/></mxCell><mxCell id="d14" value="12. Revenir à « Scannez votre QR code »" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="780"/></Array></mxGeometry></mxCell><mxCell id="d15" value="13. Mettre à jour le score du citoyen" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="fb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="855"/></Array></mxGeometry></mxCell><mxCell id="d16" value="14. Synchroniser le poids et l’état du SmartBin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;endArrow=open;" edge="1" parent="1" source="esp" target="fb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="895"/></Array></mxGeometry></mxCell><mxCell id="d17" value="15. Afficher « Dépôt enregistré » et les points" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="esp" target="hw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="0" y="935"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>