<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" modified="2026-09-21T20:45:00.000Z"><diagram name="Diagramme de séquence – Dépôt citoyen et attribution des points"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1700" pageHeight="980"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Diagramme de séquence – Dépôt citoyen et attribution des points" style="text;html=1;strokeColor=none;fillColor=none;fontSize=19;fontStyle=1;fontColor=#0B2E78;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1500" height="35" as="geometry"/></mxCell><mxCell id="cit" value="&lt;b&gt;Citoyen&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;fillColor=#F8FBFF;strokeColor=#5B6B7A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="130" height="900" as="geometry"/></mxCell><mxCell id="cam" value="&lt;b&gt;ESP32-CAM / SmartBin&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;fillColor=#F8FBFF;strokeColor=#5B6B7A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="80" width="180" height="900" as="geometry"/></mxCell><mxCell id="fb" value="&lt;b&gt;Firebase Realtime Database&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;fillColor=#F8FBFF;strokeColor=#5B6B7A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="530" y="80" width="190" height="900" as="geometry"/></mxCell><mxCell id="hw" value="&lt;b&gt;HX711 / Servomoteur / LCD&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;fillColor=#F8FBFF;strokeColor=#5B6B7A;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="220" height="900" as="geometry"/></mxCell><mxCell id="sd" value="sd Dépôt d’un déchet par un citoyen" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="65" width="1320" height="900" as="geometry"/></mxCell><mxCell id="1" value="1. Présenter le QR code" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cit" target="cam"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="2" value="2. Lire le QR code" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="cam"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="3" value="3. Vérifier le rôle dans Firebase" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="fb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="4" value="4. Retourner le rôle" style="dashed=1;endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="fb" target="cam"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="alt" value="alt" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="250" width="1100" height="360" as="geometry"/></mxCell><mxCell id="a1" value="[QR valide et rôle = user]" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="250" y="275" width="280" height="25" as="geometry"/></mxCell><mxCell id="5" value="5. Mesurer le poids avant dépôt" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="hw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="6" value="6. Retourner le poids initial" style="dashed=1;endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="hw" target="cam"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="7" value="7. Ouvrir le couvercle" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="hw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="8" value="8. Déposer le déchet" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cit" target="hw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="9" value="9. Mesurer le poids après dépôt" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="hw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="10" value="10. Calculer le poids ajouté et les points" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="cam"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ref1" value="ref Vérifier et mettre à jour le score" style="shape=umlFrame;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="530" width="360" height="65" as="geometry"/></mxCell><mxCell id="11" value="11. Mettre à jour score, poids et état" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="fb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="12" value="12. Confirmer la synchronisation" style="dashed=1;endArrow=open;html=1;fontSize=10;" edge="1" parent="1" source="fb" target="cam"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="13" value="13. Afficher « Merci ! Points ajoutés »" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="hw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" value="[QR invalide ou rôle différent de user]" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;align=left;" vertex="1" parent="1"><mxGeometry x="250" y="645" width="350" height="25" as="geometry"/></mxCell><mxCell id="14" value="14. Refuser l’opération et afficher un message" style="endArrow=block;endFill=1;html=1;fontSize=10;" edge="1" parent="1" source="cam" target="hw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="loop" value="loop [scanner à nouveau jusqu’à obtenir un QR valide]" style="shape=umlFrame;whiteSpace=