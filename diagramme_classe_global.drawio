br&gt;Le rôle est une chaîne, pas une énumération SQLAlchemy ni une sous-classe." style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fefce8;strokeColor=#ca8a04;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1280" width="380" height="180" as="geometry"/></mxCell><mxCell id="post" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;Post&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ id : Integer {PK}&lt;br&gt;+ user_id : Integer {FK}&lt;br&gt;+ user_name : String&lt;br&gt;+ user_avatar_url : String [0..1]&lt;br&gt;+ image_url : String [0..1]&lt;br&gt;+ description : Text&lt;br&gt;+ created_at : DateTime&lt;br&gt;+ likes_count : Integer = 0&lt;br&gt;+ status : String = &amp;quot;pending_review&amp;quot;&lt;br&gt;+ moderation_score : Float = 0.0&lt;br&gt;+ moderation_reason : String [0..1]&lt;br&gt;+ moderated_at : DateTime [0..1]" style="shape=rectangle;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="190" width="320" height="410" as="geometry"/></mxCell><mxCell id="comment" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;Comment&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ id : Integer {PK}&lt;br&gt;+ post_id : Integer {FK}&lt;br&gt;+ user_id : Integer {FK}&lt;br&gt;+ user_name : String&lt;br&gt;+ user_avatar_url : String [0..1]&lt;br&gt;+ content : Text&lt;br&gt;+ parent_id : Integer [0..1] {FK Comment}&lt;br&gt;+ created_at : DateTime" style="shape=rectangle;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="190" width="310" height="320" as="geometry"/></mxCell><mxCell id="like" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;Like&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ id : Integer {PK}&lt;br&gt;+ user_id 