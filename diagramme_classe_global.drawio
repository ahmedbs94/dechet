 &amp;quot;&amp;quot;&lt;br&gt;+ address : String [0..1]&lt;br&gt;+ hours : String [0..1]&lt;br&gt;+ status : String = &amp;quot;disponible&amp;quot;&lt;br&gt;+ load_level : Float = 0.0&lt;br&gt;+ created_at : DateTime" style="shape=rectangle;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;strokeWidth=2;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="190" width="330" height="370" as="geometry"/></mxCell><mxCell id="bin" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;SmartBin&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ id : Integer {PK}&lt;br&gt;+ bin_code : String {unique}&lt;br&gt;+ collection_point_id : Integer [0..1] {FK}&lt;br&gt;+ bin_type : String = &amp;quot;general&amp;quot;&lt;br&gt;+ capacity_kg : Float [0..1]&lt;br&gt;+ status : String = &amp;quot;active&amp;quot;&lt;br&gt;+ location_note : String [0..1]&lt;br&gt;+ created_at : DateTime" style="shape=rectangle;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;strokeWidth=2;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1580" y="660" width="330" height="300" as="geometry"/></mxCell><mxCell id="scan" value="&lt;div style=&quot;text-align:center;font-size:16px&quot;&gt;&lt;b&gt;BinScan&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;+ id : Integer {PK}&lt;br&gt;+ user_id : Integer {FK}&lt;br&gt;+ smart_bin_id : Integer [0..1] {FK}&lt;br&gt;+ qr_code : String&lt;br&gt;+ bin_id : String [0..1] {legacy}&lt;br&gt;+ waste_type : String = &amp;quot;general&amp;quot;&lt;br&gt;+ weight_kg : Float [0..1]&lt;br&gt;+ points_earned : Float = 0.0&lt;br&gt;+ score_before : Float = 0.0&lt;br&gt;+ score_after : Float = 0.0&lt;br&gt;+ firebase_synced : Boolean = false&lt;br&gt;+ scanned_at : DateTime" style="shape=rectangle;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=9;strokeWidth=2;fillColor=#fff7ed;strokeColor=#ea580c;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1410" y="1080" width