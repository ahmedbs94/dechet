ll><mxCell id="ePost" value="auteur  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#16a34a;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="post"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eCommentUser" value="écrit  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#16a34a;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="comment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ePostComment" value="contient  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#16a34a;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="post" target="comment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eLikeUser" value="utilisateur  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#16a34a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="like"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eLikePost" value="publication  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#16a34a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="post" target="like"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eSavedUser" value="utilisateur  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#16a34a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="saved"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eSavedPost" value="publication  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#16a34a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="post" target="saved"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eNotifRecipient" value="destinataire  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#16a34a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="notif"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eCommentSelf" value="parent  0..1 ⟷ 0..* réponses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;loopStyle=orthogonalLoopStyle;jettySize=auto;endArrow=none;html=1;strokeWidth=2;strokeColor=#16a34a;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="comment" target="comment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eCpBin" value="héberge  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#ea580c;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cp" target="bin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eBinScan" value="enregistre  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#ea580c;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bin" target="scan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eUserScan" value="effectue  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#ea580c;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="scan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eBinLog" value="historique  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#ea580c;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="bin" target="log"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eUserLog" value="collecteur  1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#ea580c;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="log"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eInstrUser" value="auteur  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#9333ea;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="instruction"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eZoneUser" value="créateur  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#9333ea;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="zone"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eGroupUser" value="créateur  1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#9333ea;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="group"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eZoneAssign" value="zone  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#9333ea;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="zone" target="assignment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eGroupAssign" value="groupe  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#9333ea;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="group" target="assignment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eCpAssign" value="cible directe  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#9333ea;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cp" target="assignment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="eCollectorAssign" value="collecteur  0..1 ⟷ 0..*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=none;html=1;strokeWidth=2;strokeColor=#9333ea;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="assignment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="&lt;b&gt;Règles de lecture&lt;/b&gt; — Traits pleins : associations issues de clés étrangères. Like et SavedPost sont des classes d'association entre User et Post. Notification.post_id et Notification.comment_id ne sont pas dessinés comme associations car le modèle ne déclare aucune clé étrangère. Aucun Score, Leaderboard, UserRole, PostStatus ou BinEtat n'est ajouté : ces classes/énumérations n'existent pas comme modèles SQLAlchemy dans le dépôt." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fillColor=#f1f5f9;strokeColor=#475569;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="140" y="1810" width="2320" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>