<mxfile host="app.diagrams.net" agent="GitHub Copilot" version="24.7.17" type="device"><diagram id="pg-global-31" name="PostgreSQL — Vue globale (31 tables)"><mxGraphModel dx="4200" dy="2800" grid="1" gridSize="10" guides="1" page="1" pageWidth="4200" pageHeight="2800" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Schéma physique PostgreSQL EcoRewind — 31 tables&lt;/b&gt;" style="text;html=1;align=center;fontSize=26;" vertex="1" parent="1"><mxGeometry x="1100" y="20" width="2000" height="50" as="geometry"/></mxCell><mxCell id="note" value="PK = clé primaire • FK = clé étrangère • UQ = contrainte unique • ? = nullable • Traits pleins = contraintes FK PostgreSQL • Les listes d'IDs stockées en TEXT/JSON ne sont pas dessinées comme FK." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#475569;fontSize=13;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="2600" height="55" as="geometry"/></mxCell><mxCell id="identity" value="IDENTITÉ" style="swimlane;startSize=35;html=1;rounded=1;fillColor=#f8fafc;swimlaneFillColor=#dbeafe;strokeColor=#2563eb;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="610" height="2500" as="geometry"/></mxCell><mxCell id="community" value="COMMUNAUTÉ / MESSAGERIE" style="swimlane;startSize=35;html=1;rounded=1;fillColor=#f8fafc;swimlaneFillColor=#dcfce7;strokeColor=#16a34a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="170" width="1130" height="2500" as="geometry"/></mxCell><mxCell id="education" value="ÉDUCATION" style="swimlane;startSize=35;html=1;rounded=1;fillColor=#f8fafc;swimlaneFillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1840" y="170" width="750" height="2500" as="geometry"/></mxCell><mxCell id="collection" value="COLLECTE / TERRITOIRE" style="swimlane;startSize=35;html=1;rounded=1;fillColor=#f8fafc;swimlaneFillColor=#f3e8ff;strokeColor=#9333ea;fontStyle=1;" vertex="1" parent="1">