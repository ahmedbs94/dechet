<mxfile host="app.diagrams.net" agent="GitHub Copilot" version="24.7.17"><diagram id="global-classes-correct" name="Classes globales corrigées"><mxGraphModel dx="2600" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1900" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Diagramme de classes global — EcoRewind&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="650" y="20" width="1300" height="50" as="geometry"/></mxCell><mxCell id="subtitle" value="Modèles SQLAlchemy persistants — attributs et associations conformes aux clés étrangères du backend" style="text;html=1;align=center;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="650" y="70" width="1300" height="30" as="geometry"/></mxCell><mxCell id="pIdentity" value="&lt;b&gt;Identité et récompenses&lt;/b&gt;" style="swimlane;html=1;startSize=35;rounded=1;strokeWidth=2;fillColor=#f8fafc;swimlaneFillColor=#dbeafe;strokeColor=#2563eb;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="500" height="1670" as="geometry"/></mxCell><mxCell id="pCommunity" value="&lt;b&gt;Communauté et notifications&lt;/b&gt;" style="swimlane;html=1;startSize=35;rounded=1;strokeWidth=2;fillColor=#f8fafc;swimlaneFillColor=#dcfce7;strokeColor=#16a34a;fontSize=15;" vertex="1" parent="1"><mxGeometry x="570" y="120" width="760" height="1670" as="geometry"/></mxCell><mxCell id="pCollection" value="&lt;b&gt;Collecte intelligente&lt;/b&gt;" style="swimlane;html=1;startSize=35;rounded=1;strokeWidth=2;fillColor=#f8fafc;swimlaneFillColor=#ffedd5;strokeColor=#ea580c;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1360" y="120" width="610" height="1670" as="geometry"/></mxCell><mxCell id="pTerritory" value="&lt;b&gt;Pilotage territorial&lt;/b&gt;" style="swimlane;html=1;startSize=35;round