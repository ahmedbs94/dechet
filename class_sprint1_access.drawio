<mxfile host="app.diagrams.net" agent="GitHub Copilot" version="24.7.17"><diagram id="s1-class-correct" name="Sprint 1 - Classes authentification"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Diagramme de classes — Sprint 1 : authentification, profils et rôles&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="330" y="30" width="1140" height="50" as="geometry"/></mxCell><mxCell id="pkgDomain" value="&lt;b&gt;Modèles SQLAlchemy persistants&lt;/b&gt;" style="swimlane;html=1;horizontal=1;startSize=38;rounded=1;strokeWidth=2;fillColor=#f8fafc;swimlaneFillColor=#e2e8f0;strokeColor=#475569;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="100" width="1160" height="820" as="geometry"/></mxCell><mxCell id="user" value="&lt;div style=&quot;text-align:center;font-size:16px;&quot;&gt;&lt;b&gt;User&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.55;&quot;&gt;+ id : Integer {PK, index}&lt;br&gt;+ email : String {unique, index}&lt;br&gt;+ full_name : String [0..1]&lt;br&gt;+ hashed_password : String&lt;br&gt;+ is_active : Boolean = true {index}&lt;br&gt;+ is_verified : Boolean = false&lt;br&gt;+ role : String = &amp;quot;user&amp;quot; {index}&lt;br&gt;+ google_id : String [0..1] {unique, index}&lt;br&gt;+ facebook_id : String [0..1] {unique, index}&lt;br&gt;+ qr_code : String {unique, index, UUID4}&lt;br&gt;+ reset_token : String [0..1] {unique, index}&lt;br&gt;+ token_expires : String [0..1]&lt;br&gt;+ avatar_url : String [0..1]&lt;br&gt;+ global_score : Float = 0.0 {index}&lt;br&gt;+ created_at : DateTime {index}&lt;br&gt;+ fcm_token : String [0..1]&lt;br&gt;+ mfa_enabled : Boolean = false&lt;br&gt;+ mfa_secret : String [0..1]&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=13;rounded=0;" vertex="1" parent="1"><mxGeometry x="150" y="180" width="500" height="620" as="geometry"/></mxCell><mxCell id="otp" value="&lt;div style=&quot;text-align:center;font-size:16px;&quot;&gt;&lt;b&gt;OTPCode&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.7;&quot;&gt;+ id : Integer {PK, index}&lt;br&gt;+ identifier : String {index}&lt;br&gt;+ code : String&lt;br&gt;+ purpose : String = &amp;quot;register&amp;quot;&lt;br&gt;+ created_at : DateTime&lt;br&gt;+ expires_at : DateTime&lt;br&gt;+ is_used : Boolean = false&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=13;rounded=0;" vertex="1" parent="1"><mxGeometry x="760" y="220" width="390" height="330" as="geometry"/></mxCell><mxCell id="noteOtp" value="&lt;b&gt;Note de conception&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px;&quot;&gt;OTPCode.identifier contient un email ou un numéro de téléphone.&lt;br&gt;&lt;br&gt;Aucune clé étrangère et aucune relation SQLAlchemy ne relient OTPCode à User.&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#fffde7;strokeColor=#f9a825;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="620" width="390" height="190" as="geometry"/></mxCell><mxCell id="noteLink" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#f9a825;" edge="1" parent="1" source="noteOtp" target="otp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pkgDto" value="&lt;b&gt;Schéma Pydantic de réponse — non persistant&lt;/b&gt;" style="swimlane;html=1;horizontal=1;startSize=38;rounded=1;strokeWidth=2;fillColor=#faf5ff;swimlaneFillColor=#ede9fe;strokeColor=#7c3aed;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1310" y="100" width="410" height="510" as="geometry"/></mxCell><mxCell id="token" value="&lt;div style=&quot;text-align:center;font-size:16px;&quot;&gt;&lt;b&gt;&amp;lt;&amp;lt;DTO&amp;gt;&amp;gt;&lt;br&gt;Token&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left;line-height:1.65;&quot;&gt;+ access_token : String&lt;br&gt;+ refresh_token : String [0..1]&lt;br&gt;+ token_type : String&lt;br&gt;+ role : String&lt;br&gt;+ id : Integer&lt;br&gt;+ email : String&lt;br&gt;+ full_name : String [0..1]&lt;br&gt;+ qr_code : String [0..1]&lt;br&gt;+ firebase_token : String [0..1]&lt;/div&gt;" style="shape=rectangle;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;strokeWidth=2;fillColor=#f3e8ff;strokeColor=#7c3aed;fontSize=13;rounded=0;" vertex="1" parent="1"><mxGeometry x="1360" y="180" width="310" height="360" as="geometry"/></mxCell><mxCell id="roles" value="&lt;b&gt;Valeurs de User.role présentes dans le modèle&lt;/b&gt;&lt;br&gt;&lt;br&gt;• user (citoyen)&lt;br&gt;• admin&lt;br&gt;• educator&lt;br&gt;• intercommunality&lt;br&gt;• pointManager&lt;br&gt;• collector" style="shape=note;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1310" y="690" width="410" height="230" as="geometry"/></mxCell><mxCell id="rolesLink" value="rôle stocké comme attribut&lt;br&gt;(aucun héritage de classes)" style="dashed=1;endArrow=open;endFill=0;html=1;strokeColor=#2e7d32;fontSize=12;" edge="1" parent="1" source="roles" target="user"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Lecture du diagramme&lt;/b&gt; : User et OTPCode sont des tables SQLAlchemy. Token est uniquement un objet de transfert retourné par l'API. Les rôles sont des valeurs de l'attribut User.role, et non des sous-classes de User." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1"><mxGeometry x="170" y="970" width="1460" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>