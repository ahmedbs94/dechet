t="30" as="geometry"/></mxCell><mxCell id="m3b" value="3b. POST /register&lt;br&gt;{email, full_name, role=user, password}" style="endArrow=block;endFill=1;html=1;fontSize=14;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="491" y="560" as="sourcePoint"/><mxPoint x="1019" y="560" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m4" value="4. Rechercher l'utilisateur par email" style="endArrow=block;endFill=1;html=1;fontSize=14;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1031" y="625" as="sourcePoint"/><mxPoint x="1939" y="625" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m5" value="5. Utilisateur existant ou aucun résultat" style="dashed=1;endArrow=open;html=1;fontSize=14;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1939" y="675" as="sourcePoint"/><mxPoint x="1031" y="675" as="targetPoint"/></mxGeometry></mxCell><mxCell id="altEmail" value="alt — Disponibilité de l'adresse email" style="shape=umlFrame;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;strokeWidth=2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="255" y="710" width="1720" height="310" as="geometry"/></mxCell><mxCell id="gExists" value="[Email déjà utilisé]" style="text;html=1;align=left;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="275" y="740" width="230" height="30" as="geometry"/></mxCell><mxCell id="m6a" value="6a. HTTP 400 — Email already registered" style="dashed=1;endArrow=open;html=1;fontSize=14;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1019" y="795" as="sourcePoint"/><mxPoint x="491" y="795" as="targetPoint"/></mxGeometry></mxCell><mxCell id="sepEmail" style="dashed=1;endArrow=none;strokeColor=#777777;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="255" y="835" as="sourcePoint"/><mxPoint x="1975" y="835" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gFree" value="[Email disponible]" style="text;html=1;align=left;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="275" y="845" width="230" height="30" as="geometry"/></mxCell><mxCell id="m6b" value="6b. Hacher le mot de passe avec bcrypt" style="endArrow=block;endFill=1;html=1;fontSize=14;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1031" y="895" as="sourcePoint"/><mxPoint x="1484" y="895" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m7" value="7. INSERT User&lt;br&gt;is_verified=false ; qr_code=UUID4" style="endArrow=block;endFill=1;html=1;fontSize=14;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1031" y="955" as="sourcePoint"/><mxPoint x="1939" y="955" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m8" value="8. POST /otp/send (email, method=email)" style="endArrow=block;endFill=1;html=1;fontSize=14;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="491" y="1055" as="sourcePoint"/><mxPoint x="1019" y="1055" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m9" value="9. Générer un code OTP à 6 chiffres (validité : 5 min)&lt;br&gt;et envoyer le courriel de vérification" style="endArrow=block;endFill=1;html=1;fontSize=14;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1031" y="1115" as="sourcePoint"/><mxPoint x="1484" y="1115" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m10" value="10. Saisir le code reçu par email" style="endArrow=block;endFill=1;html=1;fontSize=14;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="1175" as="sourcePoint"/><mxPoint x="479" y="1175" as="targetPoint"/></mxGeometry></mxCell><mxCell id="m11" value="11. POST /otp/verify {identifier, code}" style="endArrow=block;endFill=1;html=1;fontSize=14;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="491" y="1225" as="sourcePoint"/><mxPoint x="1019" y="1225" as="targetPoint"/></mxGeometry></mxCell><mxCell id="altOtp" value="alt — Vérification du code" style="shape=umlFrame;whiteSpace=wrap;html=1;fontStyle=1;fontSize=14;strokeWidth=2;fillColor=none;" vertex="1" parent="1"><mxGeometry x="255" y="1260" width="1720" height="140" as="geometry"/></mxCell><mxCell id="otpBad" value="[Code invalide ou expiré] 12a. Afficher l'erreur et proposer « Renvoyer le code »" style="dashed=1;endArrow=open;html=1;fontSize=13;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1019" y="1310" as="sourcePoint"/><mxPoint x="491" y="1310" as="targetPoint"/></mxGeometry></mxCell><mxCell id="otpGood" value="[Code valide] 12b. Marquer OTP utilisé, vérifier le compte et retourner le jeton d'accès" style="dashed=1;endArrow=open;html=1;fontSize=13;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1019" y="1365" as="sourcePoint"/><mxPoint x="491" y="1365" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>